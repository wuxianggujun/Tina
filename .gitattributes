*.sh text eol=lf
# git apply reads the patch against LF sources. With core.autocrlf=true and no
# rule here, a fresh clone checks the patch out as CRLF and it stops applying.
*.patch text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.java text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
