{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "TINA_BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 (MSVC + vcpkg)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-vs2022",
      "displayName": "Windows x64 (Visual Studio 2022 + vcpkg)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-vnext",
      "displayName": "Windows x64 vNext Null (MSVC 2026 + C++23)",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/out/build/windows-msvc-vnext",
      "cacheVariables": {
        "TINA_BUILD_EXAMPLES": "ON",
        "TINA_BUILD_TESTING": "ON",
        "TINA_BUILD_LEGACY": "OFF",
        "TINA_BUILD_RENDER_BGFX": "OFF",
        "TINA_BUILD_SHADERS": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "windows-msvc-vnext-physics2d",
      "displayName": "Windows x64 vNext Physics2D (MSVC 2026 + Box2D 3.x)",
      "inherits": "windows-msvc-vnext",
      "binaryDir": "${sourceDir}/out/build/windows-msvc-vnext-physics2d",
      "cacheVariables": {
        "TINA_BUILD_PHYSICS2D": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;physics2d"
      }
    },
    {
      "name": "windows-msvc-vnext-platform",
      "displayName": "Windows x64 vNext Platform (MSVC 2026 + GLFW + C++23)",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/out/build/windows-msvc-vnext-platform",
      "cacheVariables": {
        "TINA_BUILD_EXAMPLES": "ON",
        "TINA_BUILD_TESTING": "ON",
        "TINA_BUILD_LEGACY": "OFF",
        "TINA_BUILD_PLATFORM_GLFW": "ON",
        "TINA_BUILD_RENDER_BGFX": "OFF",
        "TINA_BUILD_SHADERS": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;platform-glfw"
      }
    },
    {
      "name": "windows-msvc-vnext-bgfx",
      "displayName": "Windows x64 vNext bgfx (MSVC 2026 + GLFW + C++23)",
      "inherits": "windows-msvc-vnext-platform",
      "binaryDir": "${sourceDir}/out/build/windows-msvc-vnext-bgfx",
      "cacheVariables": {
        "TINA_BUILD_RENDER_BGFX": "ON"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux (Ninja + vcpkg)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-wayland",
      "displayName": "Linux Wayland (Ninja + vcpkg)",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "TINA_BUILD_WAYLAND": "ON",
        "VCPKG_MANIFEST_FEATURES": "wayland"
      }
    },
    {
      "name": "linux-gcc13-vnext",
      "displayName": "Linux vNext Null (GCC 13 + C++23)",
      "inherits": "linux-ninja",
      "binaryDir": "${sourceDir}/out/build/linux-gcc13-vnext",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-13",
        "CMAKE_CXX_COMPILER": "g++-13",
        "TINA_BUILD_EXAMPLES": "ON",
        "TINA_BUILD_TESTING": "ON",
        "TINA_BUILD_LEGACY": "OFF",
        "TINA_BUILD_RENDER_BGFX": "OFF",
        "TINA_BUILD_SHADERS": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "linux-gcc13-vnext-physics2d",
      "displayName": "Linux vNext Physics2D (GCC 13 + Box2D 3.x)",
      "inherits": "linux-gcc13-vnext",
      "binaryDir": "${sourceDir}/out/build/linux-gcc13-vnext-physics2d",
      "cacheVariables": {
        "TINA_BUILD_PHYSICS2D": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;physics2d"
      }
    },
    {
      "name": "linux-gcc13-vnext-platform",
      "displayName": "Linux vNext Platform (GCC 13 + GLFW + C++23)",
      "inherits": "linux-gcc13-vnext",
      "binaryDir": "${sourceDir}/out/build/linux-gcc13-vnext-platform",
      "cacheVariables": {
        "TINA_BUILD_PLATFORM_GLFW": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;platform-glfw"
      }
    },
    {
      "name": "linux-gcc13-vnext-platform-wayland",
      "displayName": "Linux vNext Platform (GCC 13 + GLFW X11/Wayland + C++23)",
      "inherits": "linux-gcc13-vnext-platform",
      "binaryDir": "${sourceDir}/out/build/linux-gcc13-vnext-platform-wayland",
      "cacheVariables": {
        "TINA_BUILD_WAYLAND": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;platform-glfw;wayland"
      }
    },
    {
      "name": "linux-clang22-vnext",
      "displayName": "Linux vNext Null (Clang 22 + libstdc++ 15)",
      "inherits": "linux-ninja",
      "binaryDir": "${sourceDir}/out/build/linux-clang22-vnext",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-clang22-libstdcxx15.cmake",
        "TINA_BUILD_EXAMPLES": "ON",
        "TINA_BUILD_TESTING": "ON",
        "TINA_BUILD_LEGACY": "OFF",
        "TINA_BUILD_RENDER_BGFX": "OFF",
        "TINA_BUILD_SHADERS": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "linux-clang22-vnext-platform",
      "displayName": "Linux vNext Platform (Clang 22 + GLFW + C++23)",
      "inherits": "linux-clang22-vnext",
      "binaryDir": "${sourceDir}/out/build/linux-clang22-vnext-platform",
      "cacheVariables": {
        "TINA_BUILD_PLATFORM_GLFW": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;platform-glfw"
      }
    },
    {
      "name": "linux-clang22-vnext-sanitize",
      "displayName": "Linux vNext Null (Clang 22 + libstdc++ 15 + ASan/UBSan)",
      "inherits": "linux-clang22-vnext",
      "binaryDir": "${sourceDir}/out/build/linux-clang22-vnext-sanitize",
      "cacheVariables": {
        "TINA_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-clang22-vnext-physics2d-sanitize",
      "displayName": "Linux vNext Physics2D (Clang 22 + Box2D 3.x + ASan/UBSan)",
      "inherits": "linux-clang22-vnext-sanitize",
      "binaryDir": "${sourceDir}/out/build/linux-clang22-vnext-physics2d-sanitize",
      "cacheVariables": {
        "TINA_BUILD_PHYSICS2D": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;physics2d"
      }
    },
    {
      "name": "linux-clang22-vnext-platform-sanitize",
      "displayName": "Linux vNext Platform (Clang 22 + GLFW + ASan/UBSan)",
      "inherits": "linux-clang22-vnext-platform",
      "binaryDir": "${sourceDir}/out/build/linux-clang22-vnext-platform-sanitize",
      "cacheVariables": {
        "TINA_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-clang22-vnext-platform-wayland-sanitize",
      "displayName": "Linux vNext Platform (Clang 22 + GLFW X11/Wayland + ASan/UBSan)",
      "inherits": "linux-clang22-vnext-platform-sanitize",
      "binaryDir": "${sourceDir}/out/build/linux-clang22-vnext-platform-wayland-sanitize",
      "cacheVariables": {
        "TINA_BUILD_WAYLAND": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;platform-glfw;wayland"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "jobs": 2
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-msvc-vs2022",
      "configuration": "Debug",
      "jobs": 2
    },
    {
      "name": "windows-vnext-debug",
      "configurePreset": "windows-msvc-vnext",
      "configuration": "Debug",
      "jobs": 2
    },
    {
      "name": "windows-vnext-release",
      "configurePreset": "windows-msvc-vnext",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "windows-vnext-physics2d-debug",
      "configurePreset": "windows-msvc-vnext-physics2d",
      "configuration": "Debug",
      "jobs": 2
    },
    {
      "name": "windows-vnext-physics2d-release",
      "configurePreset": "windows-msvc-vnext-physics2d",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "windows-vnext-platform-debug",
      "configurePreset": "windows-msvc-vnext-platform",
      "configuration": "Debug",
      "jobs": 2
    },
    {
      "name": "windows-vnext-platform-release",
      "configurePreset": "windows-msvc-vnext-platform",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "windows-vnext-bgfx-debug",
      "configurePreset": "windows-msvc-vnext-bgfx",
      "configuration": "Debug",
      "jobs": 2
    },
    {
      "name": "windows-vnext-bgfx-release",
      "configurePreset": "windows-msvc-vnext-bgfx",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-ninja",
      "jobs": 2
    },
    {
      "name": "linux-wayland-debug",
      "configurePreset": "linux-wayland",
      "jobs": 2
    },
    {
      "name": "linux-gcc13-vnext-debug",
      "configurePreset": "linux-gcc13-vnext",
      "jobs": 2
    },
    {
      "name": "linux-gcc13-vnext-physics2d-debug",
      "configurePreset": "linux-gcc13-vnext-physics2d",
      "jobs": 2
    },
    {
      "name": "linux-gcc13-vnext-platform-debug",
      "configurePreset": "linux-gcc13-vnext-platform",
      "jobs": 2
    },
    {
      "name": "linux-gcc13-vnext-platform-wayland-debug",
      "configurePreset": "linux-gcc13-vnext-platform-wayland",
      "jobs": 2
    },
    {
      "name": "linux-clang22-vnext-debug",
      "configurePreset": "linux-clang22-vnext",
      "jobs": 2
    },
    {
      "name": "linux-clang22-vnext-platform-debug",
      "configurePreset": "linux-clang22-vnext-platform",
      "jobs": 2
    },
    {
      "name": "linux-clang22-vnext-sanitize-debug",
      "configurePreset": "linux-clang22-vnext-sanitize",
      "jobs": 2
    },
    {
      "name": "linux-clang22-vnext-physics2d-sanitize-debug",
      "configurePreset": "linux-clang22-vnext-physics2d-sanitize",
      "jobs": 2
    },
    {
      "name": "linux-clang22-vnext-platform-sanitize-debug",
      "configurePreset": "linux-clang22-vnext-platform-sanitize",
      "jobs": 2
    },
    {
      "name": "linux-clang22-vnext-platform-wayland-sanitize-debug",
      "configurePreset": "linux-clang22-vnext-platform-wayland-sanitize",
      "jobs": 2
    }
  ]
}
