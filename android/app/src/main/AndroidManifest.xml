<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Tina"
        android:hasCode="true">

        <!-- No configChanges exclusions on purpose: letting Android recreate the activity on rotation
             is what exercises the surface rebind path this slice exists to prove. Suppressing it
             would hide the very lifecycle the engine now handles. -->
        <!-- singleTask, not the default LAUNCH_MULTIPLE. The engine owns process-global state (bgfx can
             only be initialised once per process), so a second activity instance creates a second
             session whose EngineHost::Create then fails with "bgfx failed to initialize". Measured on a
             device: relaunching produced two onCreate calls with no onDestroy between them, and the app
             froze after the first background/foreground cycle. -->
        <!-- Theme.NoTitleBar, deliberately not the .Fullscreen variant. Fullscreen sets
             windowFullscreen=true, which hides the status bar at the theme level and fights the
             runtime window policy: the engine wants the surface to extend *behind* a still-visible,
             transparent status bar, not to have the bar taken away. The bars are configured in
             TinaActivity instead, where the choice is explicit and per-bar.

             layoutInDisplayCutoutMode=shortEdges lets the surface extend into the cutout area on
             both short edges. Without it the system letterboxes the window below the notch and the
             game cannot draw to the physical top of the screen. Attribute is API 27; older
             platforms ignore an unknown manifest attribute, so no version split is needed. -->
        <activity
            android:name="dev.tina.TinaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar"
            android:layoutInDisplayCutoutMode="shortEdges"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
