<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Tina"
        android:hasCode="true">

        <!-- No configChanges exclusions on purpose: letting Android recreate the activity on rotation
             is what exercises the surface rebind path this slice exists to prove. Suppressing it
             would hide the very lifecycle the engine now handles. -->
        <!-- singleTask, not the default LAUNCH_MULTIPLE. The engine owns process-global state (bgfx can
             only be initialised once per process), so a second activity instance creates a second
             session whose EngineHost::Create then fails with "bgfx failed to initialize". Measured on a
             device: relaunching produced two onCreate calls with no onDestroy between them, and the app
             froze after the first background/foreground cycle. -->
        <!-- Fullscreen with no title bar. A game owns its whole surface: the default theme's ActionBar
             both wastes the space and puts a second, differently-themed UI above the engine's own.
             The theme removes the title bar; the status and navigation bars are hidden at runtime,
             because only WindowInsetsController can do that in a way the user can swipe back. -->
        <activity
            android:name="dev.tina.TinaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
