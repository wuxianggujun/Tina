# Generated install-time inventory: hash installed bytes, not timestamps.
set(prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(relative_archive "@CMAKE_INSTALL_LIBDIR@/${CMAKE_INSTALL_CONFIG_NAME}/@CMAKE_STATIC_LIBRARY_PREFIX@Tina@CMAKE_STATIC_LIBRARY_SUFFIX@")
if(NOT EXISTS "${prefix}/${relative_archive}")
    message(FATAL_ERROR "Installed Tina archive is absent: ${relative_archive}")
endif()
file(SHA256 "${prefix}/${relative_archive}" archive_hash)
set(manifest "{}")
string(JSON manifest SET "${manifest}" schemaVersion 1)
foreach(pair IN ITEMS "version=@PROJECT_VERSION@" "buildId=@TINA_SDK_BUILD_ID@"
        "compiler=@CMAKE_CXX_COMPILER_ID@" "compilerVersion=@CMAKE_CXX_COMPILER_VERSION@"
        "platform=@CMAKE_SYSTEM_NAME@" "configuration=${CMAKE_INSTALL_CONFIG_NAME}"
        "archive=${relative_archive}" "archiveSha256=${archive_hash}")
    string(FIND "${pair}" "=" separator)
    string(SUBSTRING "${pair}" 0 ${separator} key)
    math(EXPR start "${separator} + 1")
    string(SUBSTRING "${pair}" ${start} -1 value)
    string(JSON manifest SET "${manifest}" "${key}" "\"${value}\"")
endforeach()
string(JSON manifest SET "${manifest}" pointerBytes @CMAKE_SIZEOF_VOID_P@)
set(features "[]")
set(feature_list "@TINA_SDK_FEATURES@")
foreach(feature IN LISTS feature_list)
    string(JSON count LENGTH "${features}")
    string(JSON features SET "${features}" ${count} "\"${feature}\"")
endforeach()
string(JSON manifest SET "${manifest}" features "${features}")
file(GLOB_RECURSE headers RELATIVE "${prefix}"
    "${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/tina/*.hpp"
    "${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/tina/*.h")
list(SORT headers)
set(header_hashes "{}")
foreach(header IN LISTS headers)
    file(SHA256 "${prefix}/${header}" digest)
    string(JSON header_hashes SET "${header_hashes}" "${header}" "\"${digest}\"")
endforeach()
string(JSON manifest SET "${manifest}" headers "${header_hashes}")
set(manifest_path "${prefix}/@CMAKE_INSTALL_DATAROOTDIR@/Tina/sdk-${CMAKE_INSTALL_CONFIG_NAME}.json")
file(WRITE "${manifest_path}" "${manifest}\n")
list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${manifest_path}")
