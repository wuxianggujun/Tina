@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(Tina_VERSION "@PROJECT_VERSION@")
set(Tina_BUILD_ID "@TINA_SDK_BUILD_ID@")
set(Tina_FEATURES "@TINA_SDK_FEATURES@")
set_and_check(Tina_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# A static C++ SDK is not a toolchain-independent binary. Reject tuples we can
# actually check rather than silently combining different CRT/STL/compiler ABIs.
if(CMAKE_CXX_COMPILER_LOADED AND
   (NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@" OR
    NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@" OR
    NOT "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}" STREQUAL "@CMAKE_CXX_COMPILER_ARCHITECTURE_ID@" OR
    NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@ OR
    NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@"))
    set(Tina_FOUND FALSE)
    set(Tina_NOT_FOUND_MESSAGE
        "Tina @PROJECT_VERSION@ requires its producer tuple: @CMAKE_SYSTEM_NAME@, @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@, @CMAKE_SIZEOF_VOID_P@-byte pointers. Rebuild the SDK for the consumer toolchain.")
    return()
endif()

# Capabilities describe what was compiled into the one archive. They no longer
# select independently exported libraries or lazily alter its link closure.
foreach(feature IN LISTS Tina_FEATURES)
    set(Tina_${feature}_FOUND TRUE)
endforeach()
foreach(component IN LISTS Tina_FIND_COMPONENTS)
    if(NOT component IN_LIST Tina_FEATURES)
        set(Tina_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(Tina)
if(DEFINED Tina_FOUND AND NOT Tina_FOUND)
    return()
endif()

# InstallFullSdk.ps1 can ship the producer's prebuilt dependency prefix. Prefer
# those exact Debug/Release libraries without requiring a consumer vcpkg build.
# Keep this search hint scoped: find_package(Tina) must not modify the game's
# CMAKE_PREFIX_PATH or hide a missing dependency behind the producer's checkout.
block(SCOPE_FOR VARIABLES PROPAGATE Tina_FOUND Tina_NOT_FOUND_MESSAGE)
if(EXISTS "${PACKAGE_PREFIX_DIR}/dependencies/share")
    list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}/dependencies")
endif()
if("TraceTracy" IN_LIST Tina_FEATURES)
    find_dependency(Tracy CONFIG)
endif()
if("Physics2D" IN_LIST Tina_FEATURES)
    find_dependency(box2d CONFIG)
endif()
if("Physics3D" IN_LIST Tina_FEATURES)
    find_dependency(Jolt CONFIG)
endif()
if("PlatformGlfw" IN_LIST Tina_FEATURES)
    find_dependency(glfw3 3.4 CONFIG)
endif()
if("RenderBgfx" IN_LIST Tina_FEATURES)
    include("${CMAKE_CURRENT_LIST_DIR}/TinaBgfxRuntimeTargets.cmake")
endif()
if("UIFreetype" IN_LIST Tina_FEATURES)
    find_package(freetype CONFIG QUIET)
    if(NOT freetype_FOUND)
        find_dependency(Freetype MODULE)
    endif()
    # Some static FreeType packages resolve PNG only from their vcpkg wrapper.
    # Installed SDK consumers use their platform toolchain, not that wrapper.
    # Honour the exported link closure, including LINK_ONLY generator expressions.
    if(TARGET freetype AND NOT TARGET PNG::PNG)
        get_target_property(_tina_freetype_links freetype INTERFACE_LINK_LIBRARIES)
        if(_tina_freetype_links MATCHES "PNG::PNG")
            find_dependency(PNG MODULE)
        endif()
        unset(_tina_freetype_links)
    endif()
    block(SCOPE_FOR VARIABLES)
        list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
        find_dependency(HarfBuzz MODULE)
        find_dependency(FriBidi)
        find_dependency(msdfgen CONFIG)
    endblock()
endif()
# Codecs are a base SDK capability, also used by headless source cookers.
find_dependency(Vorbis CONFIG)
find_dependency(Opus CONFIG)
find_dependency(OpusFile CONFIG)
if("AudioMiniaudio" IN_LIST Tina_FEATURES)
    if(@TINA_PACKAGE_AUDIO_MINIAUDIO_NEEDS_THREADS@)
        find_dependency(Threads)
    endif()
endif()
if("NetworkTls" IN_LIST Tina_FEATURES)
    find_dependency(MbedTLS CONFIG)
endif()
endblock()

include("${CMAKE_CURRENT_LIST_DIR}/TinaTargets.cmake")
# CMake's default imported-config fallback can otherwise select Release for a
# Debug consumer. A missing configuration is an error, not permission to mix CRTs.
foreach(configuration IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set(mapping "${configuration}")
    if(DEFINED CMAKE_MAP_IMPORTED_CONFIG_${configuration})
        set(mapping "${CMAKE_MAP_IMPORTED_CONFIG_${configuration}}")
        string(TOUPPER "${mapping}" mapping_upper)
        if(configuration STREQUAL "DEBUG" AND NOT mapping_upper STREQUAL "DEBUG")
            message(FATAL_ERROR "A Debug consumer cannot map the Tina SDK to a non-Debug CRT")
        elseif(NOT configuration STREQUAL "DEBUG" AND "DEBUG" IN_LIST mapping_upper)
            message(FATAL_ERROR "A non-Debug consumer cannot map the Tina SDK to a Debug CRT")
        endif()
    endif()
    set_property(TARGET Tina::GameSDK PROPERTY
        MAP_IMPORTED_CONFIG_${configuration} "${mapping}")
endforeach()
set(Tina_GAME_SDK_TARGETS Tina::GameSDK)
set(Tina_PACKAGE_TARGETS Tina::GameSDK)
set(Tina_WITH_AssetC @TINA_PACKAGE_WITH_ASSETC@)
set(Tina_ASSETC_HINT_DIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set(Tina_SHADER_INCLUDE_DIR "")
set(Tina_BGFX_SHADER_INCLUDE_DIR "")
if("RenderBgfx" IN_LIST Tina_FEATURES)
    set_and_check(Tina_SHADER_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_DATAROOTDIR@/Tina/shaders")
    set_and_check(Tina_BGFX_SHADER_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_DATAROOTDIR@/Tina/shaders/bgfx")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TinaGameProject.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/TinaProductInstall.cmake")
